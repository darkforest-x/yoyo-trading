__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.env.*
.DS_Store

# pip install -e build metadata: regenerated on every install
*.egg-info/
build/
dist/

# A bare "data/" also matches yoyo/data/ (source package) — keep that anchored.
# Dataset images, labels and run artefacts now live in this repo (V5 home).
/data/
/models/
/output/

# Scratch renders. The detector writes these next to whatever it thinks the
# project root is; they are never source.
_yolo_cand_tmp_*.png

# Label Studio annotation renders: 2,636 files / 272 MB, regenerated by
# tools/build_labelstudio_tasks.py. Never source. Rendered images do not enter
# git; tasks.json keeps the coordinates that actually matter.
/datasets/gold_labelstudio_v1/images/

# omo plugin's local code-review evidence cache. Tool state keyed to
# ~/.codex/plugins/..., not project source.
/.omo/
